@page
@model Application.Pages.Account.IndexModel

@{
    Model.SetTitle(Localizer["Title.Account"]);
}

@if (Model.CurrentUser is null)
{
    return;
}


@section Toolbar {
    <a asp-page="Logout" class="btn btn-danger"><span>@Localizer["Text.Logout"]</span></a>
}

<div class="my-4 d-flex flex-column gap-3">
    <div>
        <div class="fw-bold"><span>@Localizer["AppUser.Id"]</span></div>
        <div class="text-break">@Model.CurrentUser.Id</div>
    </div>
    <div>
        <div class="fw-bold"><span>@Localizer["AppUser.Username"]</span></div>
        <div class="text-break">@Model.CurrentUser.Username</div>
    </div>
    <div>
        <div class="fw-bold"><span>@Localizer["AppUser.Status"]</span></div>
        <div class="text-break">@(Model.CurrentUser.Status == 1 ? Localizer["AppUserStatus.Active"] : Localizer["AppUserStatus.Inactive"])</div>
    </div>
    <div>
        <div class="fw-bold"><span>@Localizer["AppUser.Role"]</span></div>
        <div class="text-break">@(Model.CurrentUser.Role == 1 ? "Administrator" : Model.CurrentUser.Role == 0 ? "User" : "Unknown")</div>
    </div>
</div>
