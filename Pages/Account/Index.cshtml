@page
@model Application.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Account";
}

<div class="container py-4" style="max-width: 760px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Account / @Model.Mode</h1>
        @if (Model.CurrentUser is not null)
        {
            <div class="d-flex gap-2">
                @if (Model.Mode == "ChangePassword")
                {
                    <a asp-page="./Index" class="btn btn-outline-secondary">Back to account</a>
                }
                else
                {
                    <a asp-page="./Index" asp-route-mode="ChangePassword" class="btn btn-outline-primary">Change password</a>
                }
                <form method="post" asp-page-handler="Logout">
                    <button type="submit" class="btn btn-outline-danger">Logout</button>
                </form>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-info" role="alert">@Model.Notice</div>
    }
    @if (Model.Messages.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
                @foreach (var message in Model.Messages)
                {
                    <li>@message</li>
                }
            </ul>
        </div>
    }

    @if (Model.Mode == "Login")
    {
        <form method="post" asp-page-handler="Login">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Login.Username" class="form-label">Username</label>
                <input asp-for="Login.Username" class="form-control" autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label asp-for="Login.Password" class="form-label">Password</label>
                <input asp-for="Login.Password" type="password" class="form-control" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
    }
    else if (Model.Mode == "ChangePassword")
    {
        <form method="post" asp-page-handler="ChangePassword">
            <div class="mb-3">
                <label asp-for="Password.CurrentPassword" class="form-label">Current password</label>
                <input asp-for="Password.CurrentPassword" type="password" class="form-control" autocomplete="current-password" required />
            </div>
            <div class="mb-3">
                <label asp-for="Password.NewPassword" class="form-label">New password</label>
                <input asp-for="Password.NewPassword" type="password" class="form-control" autocomplete="new-password" minlength="6" required />
            </div>
            <div class="mb-3">
                <label asp-for="Password.ConfirmPassword" class="form-label">Confirm new password</label>
                <input asp-for="Password.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="6" required />
            </div>
            <button type="submit" class="btn btn-primary">Change password</button>
        </form>
    }
    else if (Model.CurrentUser is not null)
    {
        <dl class="row">
            <dt class="col-sm-4">Username</dt><dd class="col-sm-8">@Model.CurrentUser.Username</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.CurrentUser.Status == 1 ? "Active" : "Inactive")</dd>
            <dt class="col-sm-4">Role</dt><dd class="col-sm-8">@(Model.CurrentUser.Role == 1 ? "Administrator" : Model.CurrentUser.Role == 2 ? "Manager" : "User")</dd>
        </dl>
    }
</div>
