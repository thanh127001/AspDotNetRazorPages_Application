@page
@model Application.Pages.Account.LoginModel
@{
    Model.SetTitle(Localizer["Title.Login"]);
    ViewData["ContentCol"] = 4;
}

<form method="post" class="my-4 d-flex flex-column gap-3">
    <input type="hidden" asp-for="ReturnUrl" />
    <div>
        <label asp-for="Login.Username" class="form-label">@Localizer["AppUser.Username"]</label>
        <input asp-for="Login.Username" class="form-control" autocomplete="username" required />
    </div>
    <div>
        <label asp-for="Login.Password" class="form-label">@Localizer["AppUser.Password"]</label>
        <input asp-for="Login.Password" type="password" class="form-control" autocomplete="current-password" required />
    </div>
    <div>
        <label asp-for="CaptchaInput" class="form-label">@Localizer["Text.Captcha"]</label>
        <div class="d-flex align-items-center gap-2 mb-2">
            <img id="captcha-image" src="@Model.CaptchaImageBase64"
                 class="border rounded" draggable="false" />
            <button type="button" id="refresh-captcha" class="btn btn-secondary"
                    title="RefreshCaptcha" aria-label="Refresh captcha">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
        <input asp-for="CaptchaInput" class="form-control" inputmode="numeric"
               pattern="[0-9]{6}" maxlength="6" autocomplete="off" required />
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">@Localizer["Text.Login"]</button>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('refresh-captcha')?.addEventListener('click', async function () {
            const button = this;
            button.disabled = true;
            try {
                const token = document.querySelector('form[method="post"] input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('@Url.Page("./Login", "RefreshCaptcha")', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token ?? '' },
                    credentials: 'same-origin',
                    cache: 'no-store'
                });
                if (!response.ok) {
                    throw new Error(globalThis.AppText.get("Message.CaptchaRefreshFailed"));
                }
                const data = await response.json();
                document.getElementById('captcha-image').src = data.image;
                document.getElementById('CaptchaInput').value = '';
            } catch {
                alert(globalThis.AppText.get("Message.CaptchaRefreshRetry"));
            } finally {
                button.disabled = false;
            }
        });
    </script>
}
