@page
@model Application.Pages.Account.LogoutModel
@{
    Model.SetTitle(Localizer["Title.Logout"]);
}

<form method="post" class="my-4 d-flex flex-column gap-3">
    <div class="text-danger">
        @Localizer["Message.LogoutConfirmation"]
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-danger">@Localizer["Text.Logout"]</button>
        <a asp-page="./Index" class="btn btn-secondary">@Localizer["Text.Cancel"]</a>
    </div>
</form>
