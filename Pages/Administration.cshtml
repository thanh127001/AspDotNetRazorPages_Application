@page
@model Application.Pages.AdministrationModel
@{
    ViewData["Title"] = "Administration";
}

<partial name="_AdminMenuPartial" />
<h1 class="h3 mb-3">Administration</h1>
<p class="text-body-secondary mb-4">Manage application resources and settings.</p>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    <div class="col"><a asp-page="/Setting/Index" class="card h-100 text-decoration-none text-body">
        <div class="card-body">
            <h2 class="h5"><i class="bi bi-gear me-2"></i>Settings</h2>
            <p class="text-body-secondary mb-0">Manage application settings.</p>
        </div>
    </a></div>
    <div class="col"><a asp-page="/User/Index" class="card h-100 text-decoration-none text-body">
        <div class="card-body">
            <h2 class="h5"><i class="bi bi-people me-2"></i>Users</h2>
            <p class="text-body-secondary mb-0">Manage users and roles.</p>
        </div>
    </a></div>
    <div class="col"><a asp-page="/File/Index" class="card h-100 text-decoration-none text-body">
        <div class="card-body">
            <h2 class="h5"><i class="bi bi-folder me-2"></i>Files</h2>
            <p class="text-body-secondary mb-0">Manage uploaded files.</p>
        </div>
    </a></div>
</div>
