@page "{id?}"
@model Application.Pages.Content.DetailsModel
@{
    ViewData["Title"] = "Details Content";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Details Content</h1>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-id="@Model.SelectedContent?.Id" class="btn btn-outline-primary">Edit</a>
            <a asp-page="./Index" class="btn btn-outline-secondary">Back to list</a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-info" role="alert">@Model.Notice</div>
    }

    @if (Model.SelectedContent is not null)
    {
        <dl class="row">
            <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.SelectedContent.Code</dd>
            <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.SelectedContent.Title</dd>
            <dt class="col-sm-3">Icon</dt><dd class="col-sm-9">@Model.SelectedContent.Icon</dd>
            <dt class="col-sm-3">Order</dt><dd class="col-sm-9">@Model.SelectedContent.Order</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.SelectedContent.Status == 1 ? "Active" : "Inactive")</dd>
            <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.SelectedContent.CreatedTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
            <dt class="col-sm-3">Updated</dt><dd class="col-sm-9">@(Model.SelectedContent.UpdatedTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</dd>
            <dt class="col-sm-3">Content</dt><dd class="col-sm-9"><div class="border rounded p-3 text-break" style="white-space: pre-wrap;">@Model.SelectedContent.Content</div></dd>
        </dl>
    }
</div>
