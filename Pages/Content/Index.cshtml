@page
@model Application.Pages.Content.IndexModel
@{
    ViewData["Title"] = "Content Management";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Contents</h1>
        <div class="d-flex gap-2">
            <a asp-page="./Create" class="btn btn-primary">Create content</a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-info" role="alert">@Model.Notice</div>
    }
    @if (Model.Messages.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
                @foreach (var message in Model.Messages)
                {
                    <li>@message</li>
                }
            </ul>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead><tr><th>Code</th><th>Title</th><th>Status</th><th>Order</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Contents)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Title</td>
                        <td>@(item.Status == 1 ? "Active" : "Inactive")</td>
                        <td>@item.Order</td>
                        <td class="text-nowrap">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Contents.Count == 0 && Model.Messages.Count == 0)
    {
        <p class="text-muted">No contents found.</p>
    }
</div>
