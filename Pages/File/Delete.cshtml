@page "{id?}"
@model Application.Pages.File.DeleteModel
@{
    ViewData["Title"] = "Delete File";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Delete File</h1>
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-info">@Model.Notice</div>
    }
    @if (Model.SelectedFile is not null)
    {
        <p>Delete file <strong>@Model.SelectedFile.FileName</strong>? This action cannot be undone.</p>
        <form method="post" asp-page="./Delete" asp-route-id="@Model.SelectedFile.Id">
            <button type="submit" class="btn btn-danger">Confirm delete</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }

</div>
