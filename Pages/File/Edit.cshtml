@page "{id?}"
@model Application.Pages.File.EditModel
@{
    ViewData["Title"] = "Edit File";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Edit File</h1>
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-info">@Model.Notice</div>
    }
    @if (Model.Messages.Count > 0)
    {
        <div class="alert alert-danger">
            @foreach (var message in Model.Messages)
            {
                <div>@message</div>
            }
        </div>
    }
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="FileName" class="form-label">File name</label>
            <input asp-for="FileName" class="form-control" required />
            <div class="form-text">Only the file name may change; the extension must remain the same.</div>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
    </form>

</div>
