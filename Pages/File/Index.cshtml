@page
@model Application.Pages.File.IndexModel
@{
    ViewData["Title"] = "File Management";
}

<partial name="_AdminMenuPartial" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">File Management</h1>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="alert alert-info">@Model.Notice</div>
}
@if (Model.Messages.Count > 0)
{
    <div class="alert alert-danger">
        @foreach (var message in Model.Messages) { <div>@message</div> }
    </div>
}

<form method="post" asp-page-handler="Create" enctype="multipart/form-data" class="row g-3 align-items-end mb-4">
    <div class="col-md-7">
        <label asp-for="Upload" class="form-label">Upload file (PNG, JPG, TXT, PDF; maximum 1 MB)</label>
        <input asp-for="Upload" type="file" class="form-control" accept=".png,.jpg,.jpeg,.txt,.pdf" required />
    </div>
    <div class="col-md-2">
        <label asp-for="Order" class="form-label">Order</label>
        <input asp-for="Order" type="number" class="form-control" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Upload</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr><th>File name</th><th>Type</th><th>Size</th><th>Order</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var file in Model.Files)
            {
                <tr>
                    <td class="text-break">@file.FileName</td>
                    <td>@file.FileType</td>
                    <td>@file.FileSize.ToString("N0") bytes</td>
                    <td>@file.Order</td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-success" data-file-path="@Application.Services.AppFileCacheService.GetUrl(file.Id, file.FileName)" onclick="copyFilePath(this)">Copy Path</button>
                            <a asp-page="./Index" asp-page-handler="Download" asp-route-id="@file.Id" class="btn btn-sm btn-outline-secondary">Download</a>
                            <form method="post" asp-page-handler="Edit" class="d-flex gap-1">
                                <input type="hidden" name="Id" value="@file.Id" />
                                <input type="text" name="FileName" value="@file.FileName" class="form-control form-control-sm" aria-label="Rename file" required />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Rename</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this file?');">
                                <input type="hidden" name="Id" value="@file.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Files.Count == 0 && Model.Messages.Count == 0)
{
    <p class="text-muted">No files found.</p>
}

<script>
    async function copyFilePath(button) {
        const path = button.dataset.filePath;
        try {
            await navigator.clipboard.writeText(path);
            const original = button.textContent;
            button.textContent = 'Copied!';
            setTimeout(() => button.textContent = original, 1500);
        } catch {
            window.prompt('Copy file path:', path);
        }
    }
</script>
