@page
@model Application.Pages.File.IndexModel

@{
    Model.SetTitle("Files");
}

@if (Model.Message != null)
{
    <div class="alert @(Model.Failed ? "alert-danger" : "alert-success")" role="alert">@Model.Message</div>
}
<div class="d-flex flex-wrap gap-2 my-3">
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#CreateFolder"><i class="bi bi-folder-plus"></i> Create folder</button>
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#UploadFolder"><i class="bi bi-folder"></i> Upload folder</button>
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#UploadFile"><i class="bi bi-upload"></i> Upload file</button>
</div>
<nav aria-label="Current folder" class="mb-3"><a asp-page="./Index" asp-route-path="">Files</a> / @Model.Current</nav>
<div class="table-responsive">
<table class="table align-middle">
<thead><tr><th>Name</th><th>Size</th><th class="text-end">Actions</th></tr></thead>
<tbody>
@if (Model.Current != "") { <tr><td colspan="3"><a asp-page="./Index" asp-route-path="@Model.Parent"><i class="bi bi-arrow-up"></i> ..</a></td></tr> }
@for (var i = 0; i < Model.Items.Count; i++)
{
    var item = Model.Items[i];
    <tr><td>
    @if (item.Protected) { <i class="bi bi-lock"></i> @item.Name }
    else if (item.Folder) { <a asp-page="./Index" asp-route-path="@item.Path"><i class="bi bi-folder"></i> @item.Name</a> }
    else { <i class="bi bi-file-earmark"></i> @item.Name }
    </td><td>@(item.Folder ? "—" : item.Size.ToString("N0") + " B")</td><td class="text-end">
    @if (!item.Protected) {
    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#@($"Rename-{i}")" title="Rename" aria-label="Rename"><i class="bi bi-pencil"></i></button>
    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#@($"Move-{i}")" title="Move" aria-label="Move"><i class="bi bi-folder-symlink"></i></button>
    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#@($"Delete-{i}")" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
    }
    </td></tr>
}
</tbody></table></div>
@if (Model.Items.Count == 0) { <p class="text-body-secondary">No files or folders.</p> }
<partial name="_CreateFolder" model="Model" />
<partial name="_UploadFile" model="Model" />
<partial name="_UploadFolder" model="Model" />
<partial name="_Rename" model="Model" />
<partial name="_Move" model="Model" />
<partial name="_Delete" model="Model" />
