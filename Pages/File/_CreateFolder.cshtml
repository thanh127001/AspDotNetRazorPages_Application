@model Application.Pages.File.IndexModel
<div class="modal fade" id="CreateFolder" tabindex="-1" aria-hidden="true" aria-labelledby="CreateFolder-title">
<div class="modal-dialog"><div class="modal-content">
<form method="post" asp-page="./Index" asp-page-handler="CreateFolder" >
<div class="modal-header"><h5 class="modal-title" id="CreateFolder-title">Create folder</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="modal-body">
<input type="hidden" name="Path" value="@Model.Current" />
<label class="form-label" for="folderName">Folder name</label><input id="folderName" name="name" class="form-control" required />
</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create folder</button></div>
</form></div></div></div>
