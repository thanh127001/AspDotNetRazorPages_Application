@model Application.Pages.File.IndexModel
@for (var i = 0; i < Model.Items.Count; i++)
{
    var item = Model.Items[i];
    if (item.Protected) { continue; }
<div class="modal fade" id="@($"Delete-{i}")" tabindex="-1" aria-hidden="true" aria-labelledby="@($"Delete-{i}")-title">
<div class="modal-dialog"><div class="modal-content">
<form method="post" asp-page="./Index" asp-page-handler="Delete" >
<div class="modal-header"><h5 class="modal-title" id="@($"Delete-{i}")-title">Delete</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="modal-body">
<input type="hidden" name="Path" value="@Model.Current" />
<input type="hidden" name="target" value="@item.Path" />
<p class="text-break">@item.Path</p>
<p>Delete <strong>@item.Name</strong>? Folders and all their contents will be permanently deleted.</p>
</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete</button></div>
</form></div></div></div>
}
