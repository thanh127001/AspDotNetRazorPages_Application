@page
@model Application.Pages.InitiationModel
@{
    Layout = null;
    ViewData["Title"] = "Initiation";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Application Initiation</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-4">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h4 text-center mb-2">Application Initiation</h1>
                        <p class="text-muted text-center mb-4">
                            Enter your access code to initialize the application.
                        </p>
                        @if (Model.IsLocked)
                        {
                            <div class="alert alert-danger" role="alert">
                                Too many failed attempts. Application initiation is locked.
                            </div>
                        }
                        else
                        {
                            <form method="post">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                                <div class="mb-4">
                                    <label asp-for="AccessCode" class="form-label">Access Code</label>
                                    <input asp-for="AccessCode" type="password"
                                           class="form-control"
                                           autocomplete="new-password" required autofocus />
                                    <span asp-validation-for="AccessCode" class="text-danger small"></span>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">
                                    Initialize Application
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
