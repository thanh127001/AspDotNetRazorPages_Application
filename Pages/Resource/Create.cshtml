@page
@model Application.Pages.Resource.CreateModel

@{
    Model.SetTitle("Create translation");
}

@section Toolbar {
    <a asp-page="Index" class="btn btn-secondary">Back</a>
}

<form method="post" class="my-4 d-flex flex-column gap-3">
    <div>
        <label asp-for="ResourceToCreate.Code" class="form-label">Code</label>
        <input asp-for="ResourceToCreate.Code" class="form-control" required />
    </div>
    <div>
        <label asp-for="ResourceToCreate.Culture" class="form-label">Language</label>
        <input asp-for="ResourceToCreate.Culture" class="form-control" required />
    </div>
    <div>
        <label asp-for="ResourceToCreate.Value" class="form-label">Value</label>
        <textarea asp-for="ResourceToCreate.Value" class="form-control" required></textarea>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
