@page
@model Application.Pages.Resource.DeleteModel

@{
    Model.SetTitle("Delete translation");
}

@section Toolbar {
    @if (Model.ResourceToDelete is null)
    {
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    }
    else
    {
        <a asp-page="Details" asp-route-id="@Model.ResourceToDelete.Id" class="btn btn-secondary">Back</a>
    }
}

@if (Model.ResourceToDelete is null)
{
    return;
}

<div class="alert alert-warning my-4">Are you sure you want to delete this translation?</div>

<div class="my-4 d-flex flex-column gap-3">
    <div>
        <div class="fw-bold">Id</div>
        <div class="text-break">@Model.ResourceToDelete.Id</div>
    </div>
    <div>
        <div class="fw-bold">Code</div>
        <div class="text-break">@Model.ResourceToDelete.Code</div>
    </div>
    <div>
        <div class="fw-bold">Language</div>
        <div class="text-break">@Model.ResourceToDelete.Culture</div>
    </div>
    <div>
        <div class="fw-bold">Value</div>
        <div class="text-break">@Model.ResourceToDelete.Value</div>
    </div>
</div>

<form method="post" class="my-4 d-flex flex-wrap gap-2">
    <input type="hidden" name="id" value="@Model.ResourceToDelete.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Details" asp-route-id="@Model.ResourceToDelete.Id" class="btn btn-secondary">Cancel</a>
</form>
