@page
@model Application.Pages.Resource.EditModel

@{
    Model.SetTitle("Edit translation");
}

@section Toolbar {
    @if (Model.ResourceToEdit is null)
    {
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    }
    else
    {
        <a asp-page="Details" asp-route-id="@Model.ResourceToEdit.Id" class="btn btn-secondary">Back</a>
    }
}

@if (Model.ResourceToEdit is null)
{
    return;
}

<form method="post" class="my-4 d-flex flex-column gap-3">
    <div>
        <label asp-for="ResourceToEdit.Id" class="form-label">Id</label>
        <input asp-for="ResourceToEdit.Id" class="form-control" readonly />
    </div>
    <div>
        <label asp-for="ResourceToEdit.Code" class="form-label">Code</label>
        <input asp-for="ResourceToEdit.Code" class="form-control" />
    </div>
    <div>
        <label asp-for="ResourceToEdit.Culture" class="form-label">Language</label>
        <input asp-for="ResourceToEdit.Culture" class="form-control" />
    </div>
    <div>
        <label asp-for="ResourceToEdit.Value" class="form-label">Value</label>
        <textarea asp-for="ResourceToEdit.Value" class="form-control"></textarea>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="Details" asp-route-id="@Model.ResourceToEdit.Id" class="btn btn-secondary">Cancel</a>
    </div>
</form>
