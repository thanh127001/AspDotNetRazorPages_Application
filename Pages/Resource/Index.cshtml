@page
@model Application.Pages.Resource.IndexModel

@{
    Model.SetTitle("Translations");
}

@section Toolbar {
    <a asp-page="Create" class="btn btn-primary">Create</a>
    <a asp-page="Import" class="btn btn-primary">Import</a>
}

<div class="table-responsive my-4">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Code</th>
                <th>Language</th>
                <th>Value</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var translation in Model.AppTranslationList)
            {
                <tr>
                    <td>@translation.Code</td>
                    <td>@translation.Culture</td>
                    <td>@translation.Value</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                        <a asp-page="Details" asp-route-id="@translation.Id" class="btn btn-sm btn-secondary">Details</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
