@page
@model Application.Pages.Setting.IndexModel
@{ ViewData["Title"] = "Setting Management"; }
<div class="container py-4"><h1 class="h3 mb-3">Settings</h1>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="alert alert-info">@Model.Notice</div> }
@if (Model.Messages.Count > 0) { <div class="alert alert-danger"><ul class="mb-0">@foreach(var message in Model.Messages){<li>@message</li>}</ul></div> }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead><tr><th>Code</th><th>Name</th><th>Value</th><th>Order</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var setting in Model.Settings)
                    {
                        <tr>
                            <td>@setting.Code</td>
                            <td>@setting.Name</td>
                            <td class="text-break">@setting.Value</td>
                            <td>@setting.Order</td>
                            <td class="text-nowrap">
                                <a asp-page="./Details" asp-route-id="@setting.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-page="./Edit" asp-route-id="@setting.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Settings.Count == 0 && Model.Messages.Count == 0)
        {
            <p class="text-muted">No settings found.</p>
        }
</div>
