@inject Application.Services.IAppRuntimeService Runtime
@{
    var appName = Runtime.GetSettingValue("app-name");
    var appDescription = Runtime.GetSettingValue("app-description");
    var appCopyright = Runtime.GetSettingValue("app-copyright");
    var currentPage = (ViewContext.RouteData.Values["page"]?.ToString() ?? "").TrimStart('/');
    var adminPages = new[] { "Administration", "User", "Setting", "File", "Content" };
    var showAdminMenu = adminPages.Any(page =>
        currentPage.StartsWith(page, StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appName</title>
    <meta name="description" content="@appDescription" />

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/app-bootstrap-navbar/app-bootstrap-navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <nav class="navbar navbar-expand-lg bg-body border-bottom fixed-top shadow-sm">
        <div class="container">

            <a class="navbar-brand" id="app-navbar-brand" asp-page="/Index">
                @appName
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Index"><i class="bi bi-house me-1"></i>Home</a>
                    </li>
                </ul>
                <div class="border-top border-secondary opacity-25 my-2 d-lg-none"></div>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Index" asp-route-code="Privacy"><i class="bi bi-shield-lock me-1"></i>Privacy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Index" asp-route-code="About"><i class="bi bi-info-circle me-1"></i>About</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("1"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Administration"><i class="bi bi-sliders me-1"></i>Administration</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Account/Index"><i class="bi bi-person-circle me-1"></i>Account</a>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-translate me-1"></i>Language
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button class="dropdown-item" type="button">English</button></li>
                            <li><button class="dropdown-item" type="button">Tiếng Việt</button></li>
                            <li><button class="dropdown-item" type="button">中文</button></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Spacer -->
    <div class="my-4 py-3"></div>

    <!-- Global Message Container -->
    <div id="global-message-container" class="container"></div>

    <!-- Main content -->
    <main class="container mb-5 flex-grow-1">
        <div class="bg-body rounded-4 shadow-sm p-3 p-md-4 mx-auto">
            @if (showAdminMenu)
            {
                <partial name="_AdminMenuPartial" />
            }
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-3 bg-body border-top shadow-sm">
        <div class="container">
            @appCopyright
        </div>
    </footer>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/app-navbar-overlay/app-navbar-overlay.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
