@page
@model Application.Pages.User.DetailsModel

@{
    Model.SetTitle("User details");
}


@section Toolbar {
    <a asp-page="Index" class="btn btn-secondary" data-i18n="Label.Back">Back</a>
    @if (Model.AppUserModel is not null)
    {
        <a asp-page="Edit" asp-route-id="@Model.AppUserModel.Id" class="btn btn-primary" data-i18n="Label.Edit">Edit</a>
    }
}

@if (Model.AppUserModel is null)
{
    return;
}

<div class="my-4 d-flex flex-column gap-3">
    <div>
        <div class="fw-bold"><span data-i18n="AppUser.Id">Id</span></div>
        <div class="text-break">@Model.AppUserModel.Id</div>
    </div>
    <div>
        <div class="fw-bold"><span data-i18n="AppUser.Username">Username</span></div>
        <div class="text-break">@Model.AppUserModel.Username</div>
    </div>
    <div>
        <div class="fw-bold"><span data-i18n="AppUser.Role">Role</span></div>
        <div class="text-break">
            <div class="text-break">
                @(Model.AppUserModel.Role switch
                {
                    0 => "User",
                    1 => "Administrator",
                    _ => "Unknown"
                })
            </div>
        </div>
    </div>
    <div>
        <div class="fw-bold"><span data-i18n="AppUser.Status">Status</span></div>
        <div class="text-break">
            @(Model.AppUserModel.Status switch
            {
                0 => "Inactive",
                1 => "Active",
                _ => "Unknown"
            })
        </div>
    </div>
</div>
