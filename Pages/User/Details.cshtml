@page "{id?}"
@model Application.Pages.User.DetailsModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">User Details</h1>
        <div class="d-flex gap-2">
            @if (Model.SelectedUser is not null)
            {
                <a asp-page="./Edit" asp-route-id="@Model.SelectedUser.Id" class="btn btn-outline-primary">Edit</a>
            }
            <a asp-page="./Index" class="btn btn-outline-secondary">Back to list</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-info" role="alert">@Model.Notice</div>
    }

    @if (Model.SelectedUser is not null)
    {
        <dl class="row">
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.SelectedUser.Username</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.SelectedUser.Status == 1 ? "Active" : "Inactive")</dd>
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@(Model.SelectedUser.Role == 1 ? "Administrator" : Model.SelectedUser.Role == 2 ? "Manager" : "User")</dd>
        </dl>
    }
</div>
