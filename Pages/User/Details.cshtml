@page "{id?}"
@model Application.Pages.User.DetailsModel
@{ ViewData["Title"] = "Details User"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Details User</h1><div><a asp-page="./Index" class="btn btn-outline-secondary">Back to list</a></div></div>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="alert alert-info" role="alert">@Model.Notice</div> }
@if (Model.Messages.Count > 0) { <div class="alert alert-danger"><ul class="mb-0">@foreach(var message in Model.Messages){<li>@message</li>}</ul></div> }

@if(Model.SelectedUser is not null) {
        <dl class="row">
            <dt class="col-sm-3">Username</dt><dd class="col-sm-9">@Model.SelectedUser.Username</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.SelectedUser.Status == 1 ? "Active" : "Inactive")</dd>
            <dt class="col-sm-3">Role</dt><dd class="col-sm-9">@(Model.SelectedUser.Role == 1 ? "Administrator" : Model.SelectedUser.Role == 2 ? "Manager" : "User")</dd>
        </dl>
}
</div>
