@page
@model Application.Pages.User.EditModel

@{
    Model.SetTitle("Edit user");
}

@section Toolbar {
    @if (Model.AppUserModel is null)
    {
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    }
    else
    {
        <a asp-page="Details" asp-route-id="@Model.AppUserModel.Id" class="btn btn-secondary">Back</a>
    }
}

@if (Model.AppUserModel is null)
{
    return;
}


@{
    var isAdministrator = string.Equals(
        Model.AppUserModel.Username,
        "administrator",
        StringComparison.OrdinalIgnoreCase
    );
}

<form method="post" class="my-4 d-flex flex-column gap-3">
    <div>
        <label asp-for="AppUserModel.Id" class="form-label"><span data-i18n="AppUser.Id">Id</span></label>
        <input asp-for="AppUserModel.Id" class="form-control" readonly />
    </div>
    <div>
        <label asp-for="AppUserModel.Username" class="form-label"><span data-i18n="AppUser.Username">Username</span></label>
        <input asp-for="AppUserModel.Username" class="form-control" readonly="@isAdministrator" />
    </div>
    <div>
        <label asp-for="AppUserModel.Password" class="form-label"><span data-i18n="AppUser.Password">Password</span></label>
        <input asp-for="AppUserModel.Password" class="form-control" placeholder="Leave blank to keep the current password." />
    </div>
    <div>
        <label asp-for="AppUserModel.Role" class="form-label"><span data-i18n="AppUser.Role">Role</span></label>
        @if (isAdministrator)
        {
            <input type="text" class="form-control" value="Administrator" readonly />
            <input asp-for="AppUserModel.Role" type="hidden" />
        }
        else
        {
            <select asp-for="AppUserModel.Role" class="form-select" required>
                <option value="0">User</option>
                <option value="1">Administrator</option>
            </select>
        }
    </div>
    <div>
        <label asp-for="AppUserModel.Status" class="form-label"><span data-i18n="AppUser.Status">Status</span></label>
        @if (isAdministrator)
        {
            <input type="text" class="form-control" value="Active" readonly />
            <input asp-for="AppUserModel.Status" type="hidden" />
        }
        else
        {
            <select asp-for="AppUserModel.Status" class="form-select" required>
                <option value="0">Inactive</option>
                <option value="1">Active</option>
            </select>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="Details" asp-route-id="@Model.AppUserModel.Id" class="btn btn-secondary">Cancel</a>
    </div>
</form>

