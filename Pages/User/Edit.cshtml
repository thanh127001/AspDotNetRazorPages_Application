@page "{id?}"
@model Application.Pages.User.EditModel
@{ ViewData["Title"] = "Edit User"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Edit User</h1>
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
    @if (Model.Messages.Count > 0)
    {
        <div class="alert alert-danger"><ul class="mb-0">
            @foreach (var message in Model.Messages) { <li>@message</li> }
        </ul></div>
    }
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />
        <div class="mb-3">
            <label asp-for="Input.Username" class="form-label">Username</label>
            <input asp-for="Input.Username" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label">Password</label>
            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password"  />
            <div class="form-text">Leave blank to keep the current password.</div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Status" class="form-label">Status</label>
            <select asp-for="Input.Status" class="form-select">
                <option value="0">Inactive</option>
                <option value="1">Active</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Role" class="form-label">Role</label>
            <select asp-for="Input.Role" class="form-select">
                <option value="0">User</option>
                <option value="1">Administrator</option>
                <option value="2">Manager</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
