@page
@model Application.Pages.User.IndexModel

@{
    Model.SetTitle("Users");
}

<div class="table-responsive my-4">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th><span data-i18n="AppUser.Username">Username</span></th>                
                <th><span data-i18n="AppUser.Role">Role</span></th>
                <th><span data-i18n="AppUser.Status">Status</span></th>
                <th><span data-i18n="Label.Actions">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.AppUserList)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>
                        @(user.Role switch
                        {
                            0 => "User",
                            1 => "Administrator",
                            _ => "Unknown"
                        })
                    </td>
                    <td>
                        @(user.Status switch
                        {
                            0 => "Active",
                            1 => "Inactive",
                            _ => "Unknown"
                        })
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-page="Details" asp-route-id="@user.Id" class="btn btn-sm btn-secondary">Details</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
