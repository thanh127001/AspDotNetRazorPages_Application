@page
@model Application.Pages.User.IndexModel
@{ ViewData["Title"] = "User Management"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Users</h1><div><a asp-page="./Create" class="btn btn-primary">Create user</a></div></div>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="alert alert-info" role="alert">@Model.Notice</div> }
@if (Model.Messages.Count > 0) { <div class="alert alert-danger"><ul class="mb-0">@foreach(var message in Model.Messages){<li>@message</li>}</ul></div> }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr><th>Username</th><th>Status</th><th>Role</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@(user.Status == 1 ? "Active" : "Inactive")</td>
                            <td>@(user.Role == 1 ? "Administrator" : user.Role == 2 ? "Manager" : "User")</td>
                            <td class="text-nowrap">
                                <a asp-page="./Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-page="./Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-page="./Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Users.Count == 0 && Model.Messages.Count == 0)
        {
            <p class="text-muted">No users found.</p>
        }
</div>
